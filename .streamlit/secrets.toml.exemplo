# Copie para .streamlit/secrets.toml (uso local) ou cole no campo "Secrets"
# do Streamlit Community Cloud. NUNCA envie o secrets.toml verdadeiro ao GitHub.

# Banco na nuvem (Supabase: Project Settings > Database > Connection string > URI,
# modo "Session pooler"). Sem esta linha, usa o arquivo local dados/dibes.db.
DIBES_DATABASE_URL = "postgresql://postgres.SEU_PROJETO:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# Senha para abrir o painel (opcional)
SENHA = "troque-esta-senha"
